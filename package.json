{
  "name": "cotiza-3d",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cotizaciones de impresión 3D con costos transparentes en CLP.",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.12"
  }
}
